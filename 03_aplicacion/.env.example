# Copiar a .env y poner valores reales. El archivo .env NO se sube a GitHub.

# Superusuario de PostgreSQL (solo para crear la BD y correr los scripts de init)
POSTGRES_DB=ferreteria
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_clave_postgres

# Usuario limitado con el que se conecta la aplicación
APP_DB_USER=app_ferreteria
APP_DB_PASSWORD=cambiar_clave_app

# Cadena de conexión de la API (dentro de compose el host es "db")
DATABASE_URL=postgresql://app_ferreteria:cambiar_clave_app@db:5432/ferreteria

# Firma de los tokens JWT (cadena larga y aleatoria)
JWT_SECRET=cambiar_por_cadena_aleatoria_larga
JWT_EXPIRE_MINUTES=480

# pgAdmin (http://localhost:5050)
PGADMIN_EMAIL=admin@ferreteria.com
PGADMIN_PASSWORD=cambiar_clave_pgadmin
